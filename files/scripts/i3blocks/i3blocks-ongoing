#!/bin/sh
# commands used:
# - i3blocks-mode

MODE="$( i3blocks-mode )"

COUNT="$( ls "${XDG_DESKTOP_DIR:-$HOME/Desktop}" | wc -l )"

if [ "${COUNT}" -eq 0 ]; then
  exit 0
fi

if [ "${MODE}" = 'full' ]; then
  TEXT="  ${COUNT}"
else
  TEXT=''
fi

COLOR='#{color/info/hex}'

printf '%s\n\n%s\n' "${TEXT}" "${COLOR}"
